{
  "name": "neurocenter-asset-sync",
  "version": "0.9.28",
  "description": "stdio MCP-сервер: scan/sync opencode скиллов и плагинов, определение проекта rag_db, инспекция и дельта-синхронизация индексa (LanceDB) с центральным сервером (postgres+pgvector).",
  "type": "module",
  "private": true,
  "bin": {
    "neurocenter-asset-sync": "dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.29.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@neurocenter/ollama-runtime": "file:vendor/ollama-runtime",
    "apache-arrow": "18.1.0",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "3.3.1",
    "socket.io-client": "4.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "prettier": "3.9.10"
  }
}
