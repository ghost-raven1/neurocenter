# === Docker: доверенный корпоративный CA для HTTPS-прокси ===
# Только публичные CA-сертификаты PEM, без приватного ключа; TLS остаётся включён.
# Для dev.sh up читается из .env; для Docker/production экспортируйте переменную.
# NEUROCENTER_BUILD_CA_FILE=/absolute/path/corporate-ca.pem
# Сборка Compose: node scripts/docker-build.mjs compose build
# Подробности и диагностика: docs/docker-build-ca.md

# === SSO / Blitz (oauth2-bridge) ===
# true — dev без IdP (mock user + широкие policies); false — реальный вход через Blitz
SSO_DISABLE=true
SSO_HOST=https://sso.example.test
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPE="openid profile email"
# Публичный callback (через Vite-прокси), зарегистрированный для клиента
REDIRECT_URI=http://localhost:5173/auth/callback
# Куда шлём пользователя после входа
PANEL_URL=http://localhost:5173
# Публичный HTTP(S) origin API Gateway для ссылок и пакетов установщика, без /api.
# Пусто: native dev использует http://localhost:4000, production/Docker — PANEL_URL через nginx.
# Независим от внутреннего VITE_API_PROXY_TARGET; frontend получает значение при запуске через API.
API_PUBLIC_URL=

# === Frontend: цели dev-прокси Vite ===
VITE_AUTH_PROXY_TARGET=http://localhost:22222
VITE_API_PROXY_TARGET=http://localhost:4000
# Необязательная ссылка на ваш мониторинг моделей (http/https).
VITE_MODEL_MONITOR_URL=

# === api-gateway → микросервисы ===
# Каталог (проекты/версии/скиллы/пакеты/операции/аудит/maintenance) — каталожный microservice
CATALOG_SERVICE_URL=http://localhost:4100
# Скиллы (CephFS/.md)
SKILLS_SERVICE_URL=http://localhost:4200
# RAG-дельта-синхронизация (postgres+pgvector, develop-индекс)
RAG_SERVICE_URL=http://localhost:4300
FEATURE_FLAGS_SERVICE_URL=http://localhost:4400
# auth-guard: валидация session-cookie у oauth2-bridge
AUTH_SERVICE_URL=http://localhost:22222
AUTH_GUARD_ENABLED=true

# === БД микросервисов (тот же Postgres-инстанс, что RAG) ===
# Каталог проектов (БД catalog, PG-backed)
CATALOG_PG_URL=postgresql://rag:rag@localhost:5432/catalog
# skills-service: локальный каталог .md-скиллов (dev; prod — /cephfs/lancedb/skills)
SKILLS_STORAGE_PATH=data/skills

# === rag-sync-service: Postgres + pgvector ===
# Строка подключения (host: postgres-контейнер на :5432, user/db = rag)
RAG_PG_URL=postgresql://rag:rag@localhost:5432/rag
# Размерность эмбеддингов (qwen3-embedding-4b = 2560)
RAG_DIM=2560
# Роль, необходимая для записи (x-bridge-roles). Чтение — по сессии.
RAG_WRITE_ROLE=rag:write
# DEV-обход role-gate (true = не проверять роли). В prod обязательно false.
RAG_AUTH_DISABLED=true

# === Проектный хостинг моделей (в Docker адрес задаётся Compose) ===
# Dev использует тот же runtime и веса, что npm run embedding:up / vision:up.
MODEL_RUNTIME_URL=http://127.0.0.1:11435
MODEL_HOSTING_ENABLED=true
# Выделяемое окно управляемой Ollama: передаётся num_ctx и используется автосжатием.
# По умолчанию managed dev/Compose явно используют 4096. Для внешнего runtime задайте явно.
# MODEL_CHAT_CONTEXT_WINDOW_TOKENS=4096

# === Файлы чата: приватные бакеты Ceph RGW / S3 ===
# Без внешней конфигурации dev.sh up запускает локальный S3 на 127.0.0.1:19010.
# Для Ceph заполните все поля ниже. Ключи получает только catalog-service.
# В production нужен HTTPS; бакеты должны быть приватными.
# CHAT_S3_ENDPOINT=https://s3.example.test
# CHAT_S3_REGION=us-east-1
# CHAT_S3_PROJECT_BUCKET=neurocenter-chat-projects
# CHAT_S3_PERSONAL_BUCKET=neurocenter-chat-personal
# CHAT_S3_ACCESS_KEY_FILE=/run/secrets/chat_s3_access_key
# CHAT_S3_SECRET_KEY_FILE=/run/secrets/chat_s3_secret_key
# Docker: добавьте -f compose.chat-storage.yml и вместо *_FILE задайте пути на хосте:
# CHAT_S3_ACCESS_KEY_PATH=/private/ceph-access-key
# CHAT_S3_SECRET_KEY_PATH=/private/ceph-secret-key
# CHAT_DEV_S3_PORT=19010

# === catalog-service: базовый каталог корней проектов (для автопроставления fs_root_path) ===
# Каждый проект получает fs_root_path = ${PROJECTS_ROOT}/<имя> (универсально, без хардкода).
# В контейнере — mounted volume; в dev — домашняя папка с проектами.
PROJECTS_ROOT=/data/projects

# === Доставка ассетов (docs/assets.md) ===
# offline читает закреплённые metadata и бинарники из RUNTIME_ARTIFACT_DIR без GitHub.
ASSET_SOURCE_MODE=online
# Для compose.offline-assets.yml: существующая папка с полным SHA-кэшем поставки.
OFFLINE_ASSETS_DIR=./offline-assets

# === Мост neurocenter-asset-sync (обратная синхронизация pgvector → локальная LanceDB) ===
# node (18+/22): в контейнере — просто 'node'; в dev — абсолютный путь к бинарнику.
ASSET_SYNC_NODE_BIN=node
# Абсолютный путь к dist/index.js моста: в контейнере — путь в образе; в dev — repo-путь.
ASSET_SYNC_MCP_BIN=/app/mcp/neurocenter-asset-sync/dist/index.js
# Корень проекта с .opencode/rag_db (в контейнере — mounted volume; в dev — repo-путь).
ASSET_SYNC_PROJECT_ROOT=/data/project
