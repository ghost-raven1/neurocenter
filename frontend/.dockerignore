node_modules
dist
.env*
*.tsbuildinfo

# Registry settings and credentials never enter the image build context.
**/.npmrc
**/.yarnrc
**/.yarnrc.yml

# Build CA inputs are per invocation; legacy extra.pem never enters the Docker context.
docker/build-ca/*
!docker/build-ca/.gitkeep
!docker/build-ca/ca-*.pem
