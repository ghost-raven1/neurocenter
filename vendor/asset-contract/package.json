{
  "name": "@neurocenter/asset-contract",
  "version": "1.2.1",
  "description": "Native asset descriptors, pinned repository reader and publication adapters for Neurocenter",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./index.d.ts",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
