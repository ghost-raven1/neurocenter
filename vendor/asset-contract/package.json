    "skills/neurocenter-project-learning",
    "skills/neurocenter-system-assistance"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node bin/assets.mjs validate .",
    "check:native": "node bin/check-native.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ghost-raven1/neurocenter-assets.git"
  }
