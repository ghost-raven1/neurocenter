<mxCell id="subtitle" value="OAuth подтверждает субъект; решение по конкретному ресурсу принимает отдельный сервис ACL" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="78" width="1560" height="48" /></mxCell>
<mxCell id="client" value="Локальный MCP&#10;Public native OAuth client&#10;Токены в системном keychain" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=18;fontStyle=0;fillColor=#e9f0fa;strokeColor=#6488b4;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="130" /></mxCell>
