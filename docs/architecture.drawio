<mxCell id="title" value="02 · Скачивание и публикация снимка" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=28;fontStyle=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1560" height="45" /></mxCell>
<mxCell id="subtitle" value="Снимок закреплён по ID · нет частичной активации · нет автоматического слияния строк" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="78" width="1560" height="48" /></mxCell>
<mxCell id="p1" value="Проверить download / sync.pull&#10;Закрепить snapshot ID + manifest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=18;fontStyle=0;fillColor=#e7eff9;strokeColor=#6488b4;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="85" y="220" width="585" height="90" /></mxCell>
<mxCell id="p2" value="Сравнить хеши и свободное место&#10;Получить разрешения на новые чанки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=18;fontStyle=0;fillColor=#e7eff9;strokeColor=#6488b4;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="85" y="360" width="585" height="90" /></mxCell>
<mxCell id="p3" value="S3 → локальный агент&#10;Докачка · журнал · до 4 запросов" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=18;fontStyle=0;fillColor=#e5f4ee;strokeColor=#4b9d82;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="85" y="500" width="585" height="90" /></mxCell>
<mxCell id="p4" value="SHA-256 + подпись + формат&#10;Открыть таблицы LanceDB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=18;fontStyle=0;fillColor=#e5f4ee;strokeColor=#4b9d82;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="85" y="640" width="585" height="90" /></mxCell>
<mxCell id="p5" value="Свежие права + local release-lock&#10;Атомарно переключить CURRENT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=18;fontStyle=0;fillColor=#e5f4ee;strokeColor=#4b9d82;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="85" y="780" width="585" height="90" /></mxCell>
<mxCell id="pullnote" value="Обрыв / dirty workspace: текущая версия сохраняется.&#10;Новый server head не меняет уже выбранный снимок." style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=16;fontStyle=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="85" y="895" width="585" height="48" /></mxCell>
<mxCell id="u1" value="ACL + квота + head ID/revision&#10;Upload session · lease / fencing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;fillColor=#e7eff9;strokeColor=#6488b4;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="210" width="510" height="80" /></mxCell>
<mxCell id="u2" value="Загрузить только новые чанки в staging&#10;Прямой HTTPS S3; final bucket закрыт" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;fillColor=#e7eff9;strokeColor=#6488b4;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="320" width="510" height="80" /></mxCell>
<mxCell id="u3" value="Finalize → SEALED&#10;Закрепить objectVersionId; свежие права" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;fillColor=#e7eff9;strokeColor=#6488b4;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="430" width="510" height="80" /></mxCell>
<mxCell id="u4" value="Worker: hashes + portable LanceDB&#10;Копировать проверенные object versions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;fillColor=#fff1d6;strokeColor=#c49b48;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="540" width="510" height="80" /></mxCell>
<mxCell id="u5" value="Автор: свежий publish + fencing&#10;VERIFIED · final objects и refs готовы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;fillColor=#e5f4ee;strokeColor=#4b9d82;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="650" width="510" height="80" /></mxCell>
<mxCell id="cas" value="Head ID&#10;+ revision&#10;совпали?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=17;fontStyle=0;fillColor=#fff1d6;strokeColor=#c49b48;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="885" y="747" width="350" height="125" /></mxCell>
<mxCell id="conflict" value="CONFLICT&#10;Head прежний&#10;Кандидат сохранён" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=16;fontStyle=0;fillColor=#fbe8e6;strokeColor=#bf716a;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1375" y="768" width="175" height="90" /></mxCell>
<mxCell id="commit" value="PG: head + revision + audit + outbox&#10;Релиз: также active profile и revision" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=16;fontStyle=0;fillColor=#e5f4ee;strokeColor=#4b9d82;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="900" width="510" height="65" /></mxCell>
<mxCell id="yes" value="да" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=15;fontStyle=0;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="874" width="45" height="24" /></mxCell>
