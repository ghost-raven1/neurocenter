<mxCell id="limits" value="Граница гарантии&#10;Scopes ≠ права на проект&#10;Admin не обходит внешний deny&#10;Уже скачанные файлы не отозвать" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontColor=#243449;fontSize=18;fontStyle=0;fillColor=#f3f5f8;strokeColor=#9aa9ba;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1160" y="750" width="420" height="170" /></mxCell>
