{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2021",
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true
    },
    "include": ["src/**/*"]
}
