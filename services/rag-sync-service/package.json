{
  "name": "rag-sync-service",
  "version": "0.1.0",
  "private": true,
  "description": "\u041c\u0438\u043a\u0440\u043e\u0441\u0435\u0440\u0432\u0438\u0441 RAG-\u0434\u0435\u043b\u044c\u0442\u0430-\u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u0438 lancedb-storage (postgres + pgvector, develop-\u0438\u043d\u0434\u0435\u043a\u0441, role-gated)",
  "scripts": {
    "build": "nest build",
    "postbuild": "node ../../scripts/workspace/dist-freshness.mjs --write services/rag-sync-service",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src integration --no-error-on-unmatched-pattern --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"integration/test/**/*.{ts,mjs,cjs}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"integration/test/**/*.{ts,mjs,cjs}\""
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.11.9",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "prettier": "3.9.10"
  }
}
