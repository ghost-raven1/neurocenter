# Порт SSO-моста (совпадает с default VITE_DEV_PROXY_TARGET в frontend)
PORT=22222

# Dev-режим без IdP (mock user + широкие policies). true — для локальной проверки без клиента.
SSO_DISABLE=true

# === При реальном входе через Blitz (SSO_DISABLE=false) ===
SSO_HOST=https://sso.example.test
# Клиент, зарегистрированный у вашего поставщика SSO
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPE=openid profile email
# Публичный callback, зарегистрированный для клиента (через Vite-прокси :5173)
REDIRECT_URI=http://localhost:5173/auth/callback
# Куда шлём пользователя после входа
PANEL_URL=http://localhost:5173
