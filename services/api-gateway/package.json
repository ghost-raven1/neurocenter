{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Front-facing api-gateway: /api/* → микросервисы (fan-out), /socket.io → real-time; auth-guard",
  "scripts": {
    "docs:generate": "node ../../scripts/openapi/generate.mjs --output src/docs/openapi.json",
    "build": "npm run docs:generate && nest build",
    "start": "npm run docs:generate && nest start",
    "start:dev": "npm run docs:generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "axios": "^1.7.7",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@neurocenter/asset-contract": "file:../../vendor/asset-contract",
    "@types/express": "4.17.21",
    "@types/node": "^20.19.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "prettier": "3.9.10"
  },
  "overrides": {
    "swagger-ui-dist": "5.14.0"
  }
}
