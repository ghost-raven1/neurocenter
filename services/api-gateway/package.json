{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Front-facing api-gateway: /api/* → микросервисы (fan-out), /socket.io → real-time; auth-guard",
  "scripts": {
    "docs:generate": "node ../../scripts/openapi/generate.mjs --output src/docs/openapi.json",
    "build": "npm run docs:generate && nest build",
    "start": "npm run docs:generate && nest start",
    "start:dev": "npm run docs:generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "axios": "^1.7.7",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@neurocenter/asset-contract": "https://codeload.github.com/ghost-raven1/neurocenter-assets/tar.gz/2bcbdcbd77d003c078ce6357d64375de6ede1ff6",
    "@types/express": "4.17.21",
    "@types/node": "^20.19.0",
    "@types/pg": "8.23.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "swagger-ui-dist": "5.14.0"
  }
}
